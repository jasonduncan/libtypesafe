@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json 3.11)
if(@LIBTYPESAFE_WITH_CURL@)
  # The static library links libcurl privately, so consumers need it at link time.
  find_dependency(CURL 7.84)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libtypesafeTargets.cmake")
check_required_components(libtypesafe)
